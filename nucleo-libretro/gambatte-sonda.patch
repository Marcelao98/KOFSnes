+      static uint_least32_t tmp[4096];
+      static uint_least32_t soma[4] = { 0x8000, 0x8000, 0x8000, 0x8000 };
+      static unsigned fase = 0;
+      unsigned long feito = 0;
+      while (feito < cycles) {
+         unsigned long n = std::min(cycles - feito, 4096ul);
