+    /** Contador de shift INT: o caminho BigInt do toNumber32 aloca dois
+     *  BigInt por shift (num emulador, milhões por quadro: ~100x mais lento).
+     *  Literal Number vai direto; expressão sem efeito colateral só passa por
+     *  BigInt se for mesmo BigInt (contador Long); o resto segue o caminho
+     *  antigo. O JS já mascara o contador em 0x1f, como o JVM. */
+    static JsIr.JsExpression intShiftCount(JsIr.JsExpression e) {
+        if (e instanceof JsIr.JsNumber n && !n.text().endsWith("n")) return e;
+        if (semEfeito(e)) {
+            return new JsIr.JsConditional(
+                    new JsIr.JsBinary(new JsIr.JsUnary("typeof", e), "===", new JsIr.JsString("bigint")),
+                    toNumber32(e), e);
+        }
+        return toNumber32(e);
+    }
+
+    private static boolean semEfeito(JsIr.JsExpression e) {
+        if (e instanceof JsIr.JsNumber || e instanceof JsIr.JsIdentifier || e instanceof JsIr.JsThis) return true;
+        if (e instanceof JsIr.JsMember m) return semEfeito(m.target());
+        if (e instanceof JsIr.JsUnary u) return !u.operator().contains("+") && !u.operator().contains("-") && semEfeito(u.operand());
+        if (e instanceof JsIr.JsBinary b) return semEfeito(b.left()) && semEfeito(b.right());
+        return false;
+    }
+
     static JsIr.JsExpression int32(JsIr.JsExpression e) {
         return new JsIr.JsBinary(e, "|", new JsIr.JsNumber("0"));
     }
